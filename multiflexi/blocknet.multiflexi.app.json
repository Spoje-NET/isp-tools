{
  "$schema": "https://multiflexi.eu/schema/application.json",
  "schemaVersion": "3.4.0",
  "uuid": "8f3c4a5e-9b2d-4e1f-a6d8-7c9e0f1a2b3c",
  "version": "1.0.0",
  "name": {
    "en": "Block Internet Access",
    "cs": "Zablokovat přístup k internetu"
  },
  "description": {
    "en": "Block internet access for all clients with ODPOJEN (DISCONNECTED) label",
    "cs": "Zablokuje internet všem klientům kteří mají štítek ODPOJEN"
  },
  "requirements": [
    "AbraFlexi",
    "NetBox"
  ],
  "tags": [
    "AbraFlexi",
    "ISP",
    "Network",
    "NetBox"
  ],
  "homepage": "https://github.com/Spoje-NET/isp-tools",
  "executable": "blocknet",
  "events": {
    "consumes": {
      "adresar.updated": {
        "description": "AbraFlexi address record updated - reacts when mark-defaulters sets the ODPOJENO label"
      }
    },
    "emits": {
      "network.blocked": {
        "description": "Network access was blocked"
      }
    }
  },
  "environment": {
    "CUSTOMER": {
      "type": "string",
      "description": {
        "en": "Customer code or ID (adresar) to disconnect. If empty, all disconnected customers are processed.",
        "cs": "Kód nebo ID zákazníka (adresar) k odpojení. Pokud je prázdné, zpracují se všichni odpojení zákazníci."
      },
      "defval": "",
      "required": false,
      "category": "Behavior"
    },
    "ABRAFLEXI_COMPANY": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Company code",
        "cs": "Kód společnosti v AbraFlexi"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_LOGIN": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Login",
        "cs": "Přihlašovací jméno do AbraFlexi"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_PASSWORD": {
      "type": "password",
      "description": {
        "en": "AbraFlexi password",
        "cs": "Heslo do AbraFlexi"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "ABRAFLEXI_URL": {
      "type": "string",
      "description": {
        "en": "AbraFlexi Server URI",
        "cs": "Adresa serveru AbraFlexi"
      },
      "defval": "https://demo.flexibee.eu:5434",
      "required": true,
      "category": "API"
    },
    "SVNUSER": {
      "type": "string",
      "description": {
        "en": "SVN user name used to commit network configuration changes",
        "cs": "Uživatelské jméno do SVN pro zápis změn síťové konfigurace"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "SVNPASS": {
      "type": "password",
      "description": {
        "en": "SVN password",
        "cs": "Heslo do SVN"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "SVNURL": {
      "type": "url",
      "description": {
        "en": "SVN repository URL with network configuration",
        "cs": "URL SVN repozitáře se síťovou konfigurací"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "SVNBIN": {
      "type": "file-path",
      "description": {
        "en": "Path to the svn client binary",
        "cs": "Cesta ke spustitelnému souboru svn klienta"
      },
      "defval": "/usr/bin/svn",
      "required": true,
      "category": "Other"
    },
    "NETBOX_URL": {
      "type": "url",
      "description": {
        "en": "NetBox instance base URL (from NetBox credential)",
        "cs": "Základní URL instance NetBox (z NetBox credential)"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "NETBOX_TOKEN": {
      "type": "password",
      "description": {
        "en": "NetBox API token (from NetBox credential)",
        "cs": "API token NetBox (z NetBox credential)"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "NETWORK_BACKEND": {
      "type": "string",
      "description": {
        "en": "Network backend: svn (default), netbox, or composite (SVN then NetBox dual-write)",
        "cs": "Síťový backend: svn (výchozí), netbox, nebo composite (SVN a pak dual-write do NetBox)"
      },
      "defval": "svn",
      "required": false,
      "category": "Other"
    },
    "LOGFILE": {
      "type": "file-path",
      "description": {
        "en": "Path to the log file",
        "cs": "Cesta k souboru s logem"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "LABEL_DISCONNECTED": {
      "type": "string",
      "description": {
        "en": "Label to set on customers marked for disconnection (must match isp-tools blocknet config)",
        "cs": "Štítek nastavený zákazníkům určeným k odpojení (musí odpovídat nastavení blocknet)"
      },
      "defval": "ODPOJENO",
      "required": false,
      "category": "Other"
    },
    "LABEL_VIP": {
      "type": "string",
      "description": {
        "en": "VIP customers are skipped",
        "cs": "VIP zákazníci jsou přeskočeni"
      },
      "defval": "VIP",
      "required": false,
      "category": "Other"
    },
    "LABEL_NODISCONNECT": {
      "type": "string",
      "description": {
        "en": "Customers with this label are never marked for disconnection",
        "cs": "Zákazníci s tímto štítkem nebudou nikdy označeni k odpojení"
      },
      "defval": "NEODPOJOVAT",
      "required": false,
      "category": "Other"
    },
    "RESULT_FILE": {
      "type": "string",
      "description": {
        "en": "Write output json data to",
        "cs": "Zapsat výstupní json data do"
      },
      "defval": "blocknet_result.json",
      "required": false,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "Write log messages using",
        "cs": "Způsob zápisu logovacích zpráv"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    }
  }
}
